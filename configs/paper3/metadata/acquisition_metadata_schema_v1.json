{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openew-sa.local/schema/acquisition-metadata/1.0.0",
  "title": "OpenEW-SA target-free acquisition metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "acquisition_session_id",
    "capture_id",
    "within_capture_index"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sample_id": {"type": "string", "minLength": 1},
    "acquisition_session_id": {"type": "string", "minLength": 1},
    "capture_id": {"type": "string", "minLength": 1},
    "within_capture_index": {"type": "integer", "minimum": 0},
    "timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "timestamp_source": {"type": ["string", "null"]},
    "timestamp_resolution_ns": {"type": ["integer", "null"], "minimum": 0},
    "timestamp_uncertainty_ns": {"type": ["integer", "null"], "minimum": 0},
    "clock_domain": {"type": ["string", "null"]},
    "clock_reset_id": {"type": ["string", "null"]},
    "receiver_id": {"type": ["string", "null"]},
    "station_id": {"type": ["string", "null"]},
    "site_id": {"type": ["string", "null"]},
    "sensor_id": {"type": ["string", "null"]},
    "hardware_model": {"type": ["string", "null"]},
    "hardware_serial_hash": {"type": ["string", "null"]},
    "firmware_version": {"type": ["string", "null"]},
    "antenna_id": {"type": ["string", "null"]},
    "antenna_configuration": {"type": ["string", "null"]},
    "center_frequency_hz": {"type": ["number", "null"], "minimum": 0},
    "lower_frequency_hz": {"type": ["number", "null"], "minimum": 0},
    "upper_frequency_hz": {"type": ["number", "null"], "minimum": 0},
    "bandwidth_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "sample_rate_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "channel_id": {"type": ["string", "null"]},
    "location_id": {"type": ["string", "null"]},
    "location_precision_class": {"type": ["string", "null"]},
    "campaign_id": {"type": ["string", "null"]},
    "environment_context_id": {"type": ["string", "null"]},
    "operational_context_id": {"type": ["string", "null"]},
    "source_file_id": {"type": ["string", "null"]},
    "source_record_index": {"type": ["integer", "null"], "minimum": 0},
    "metadata_missing_mask": {"type": "array", "items": {"type": "string"}},
    "metadata_quality_flags": {"type": "array", "items": {"type": "string"}}
  }
}
