{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenEW-SA public RF candidate qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "dataset_name", "task",
    "official_source", "official_paper", "license", "license_verified",
    "download_size_bytes", "receiver_count", "site_count", "day_count",
    "session_count", "timestamp_available", "order_available",
    "frequency_available", "sample_rate_available", "annotation_separated",
    "target_field", "target_proxy_fields", "relation_allowed_fields",
    "temporal_status", "metadata_readiness", "access_status",
    "adoption_status", "evidence_confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "dataset_name": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "official_source": {"type": ["string", "null"]},
    "official_paper": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "license_verified": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "download_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "receiver_count": {"type": ["integer", "null"], "minimum": 0},
    "site_count": {"type": ["integer", "null"], "minimum": 0},
    "day_count": {"type": ["integer", "null"], "minimum": 0},
    "session_count": {"type": ["integer", "null"], "minimum": 0},
    "timestamp_available": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "order_available": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "frequency_available": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "sample_rate_available": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "annotation_separated": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "target_field": {"type": ["string", "null"]},
    "target_proxy_fields": {"type": "array", "items": {"type": "string"}},
    "relation_allowed_fields": {"type": "array", "items": {"type": "string"}},
    "temporal_status": {"type": "string"},
    "metadata_readiness": {"type": "string"},
    "access_status": {"type": "string"},
    "adoption_status": {"type": "string"},
    "evidence_confidence": {"type": "string"}
  }
}
